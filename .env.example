# Supabase Configuration
#
# For local dev, run `npx supabase start` then `npx supabase status` and copy
# the values into .env (gitignored; do not commit .env).
#   VITE_SUPABASE_URL        = supabase url   (http://127.0.0.1:54321 default,
#                                          or a shifted port from config.toml)
#   VITE_SUPABASE_ANON_KEY   = api key        (the JWT named "anon")
#   VITE_SUPABASE_SERVICE_KEY= service_role  (listed as "service_role" — the
#                                          smoke test cleanup needs it;
#                                          never expose it in the app frontend)
#
# For cloud projects, use Dashboard → Settings → API values instead.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
